{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Jev issue triage configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "model", "thresholds", "issueTypes", "severityLevels", "labels", "questions"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "model": { "type": "string", "minLength": 1 },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["needsRepoInvestigation", "hasEnoughInformation"],
      "properties": {
        "needsRepoInvestigation": { "type": "number", "minimum": 0, "maximum": 1 },
        "hasEnoughInformation": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "issueTypes": { "$ref": "#/definitions/catalog" },
    "severityLevels": { "$ref": "#/definitions/catalog" },
    "labels": { "type": "object", "minProperties": 4, "additionalProperties": { "$ref": "#/definitions/label" } },
    "questions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue_type", "severity", "needs_repo_investigation", "has_enough_information"],
      "properties": {
        "issue_type": { "$ref": "#/definitions/question" },
        "severity": { "$ref": "#/definitions/question" },
        "needs_repo_investigation": { "$ref": "#/definitions/question" },
        "has_enough_information": { "$ref": "#/definitions/question" }
      }
    }
  },
  "definitions": {
    "catalog": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "object", "required": ["label", "color", "description", "criteria"], "additionalProperties": false, "properties": { "order": { "type": "integer", "minimum": 0 }, "label": { "type": "string", "minLength": 1 }, "color": { "type": "string", "pattern": "^[0-9a-fA-F]{6}$" }, "description": { "type": "string", "minLength": 1 }, "criteria": { "type": "string", "minLength": 1 } } }
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "color", "description"],
      "properties": { "label": { "type": "string", "minLength": 1 }, "color": { "type": "string", "pattern": "^[0-9a-fA-F]{6}$" }, "description": { "type": "string", "minLength": 1 } }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "instructions"],
      "properties": { "type": { "enum": ["choice", "score", "noul"] }, "instructions": { "type": "string", "minLength": 1 }, "criteria": { "oneOf": [{ "type": "array", "items": { "type": "string", "minLength": 1 } }, { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }] } }
    }
  }
}
